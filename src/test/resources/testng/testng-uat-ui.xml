<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="EFMS UAT UI Suite" parallel="tests" thread-count="2" verbose="1">
    <listeners>
        <listener class-name="com.logtechub.automation.listeners.TestListener"/>
    </listeners>

    <test name="UAT UI - Chrome">
        <parameter name="browser" value="chrome"/>
        <classes>
            <class name="com.logtechub.automation.tests.ui.UatHomePageTest"/>
        </classes>
    </test>

    <test name="UAT UI - Edge">
        <parameter name="browser" value="edge"/>
        <classes>
            <class name="com.logtechub.automation.tests.ui.UatHomePageTest"/>
        </classes>
    </test>
</suite>
