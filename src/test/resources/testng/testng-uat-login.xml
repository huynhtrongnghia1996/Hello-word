<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="EFMS ETMS UAT Login Suite" parallel="tests" thread-count="2" verbose="1">
    <listeners>
        <listener class-name="io.qameta.allure.testng.AllureTestNg"/>
        <listener class-name="com.logtechub.automation.listeners.TestListener"/>
    </listeners>

    <test name="UAT Login - Chrome">
        <parameter name="browser" value="chrome"/>
        <classes>
            <class name="com.logtechub.automation.tests.ui.efms.EfmsLoginTest"/>
            <class name="com.logtechub.automation.tests.ui.etms.EtmsLoginTest"/>
        </classes>
    </test>

    <test name="UAT Login - Edge">
        <parameter name="browser" value="edge"/>
        <classes>
            <class name="com.logtechub.automation.tests.ui.efms.EfmsLoginTest"/>
            <class name="com.logtechub.automation.tests.ui.etms.EtmsLoginTest"/>
        </classes>
    </test>
</suite>
